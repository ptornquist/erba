# Supabase project settings → API
# Optional: the game runs fully from the local catalog if these are unset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by POST /api/validate and /api/score to read public.puzzles
# (bypasses RLS). Never expose this in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
